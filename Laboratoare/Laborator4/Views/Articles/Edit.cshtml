@model Laborator4.Models.Article

<h2>Editează articol</h2>

<form method="post" action="/Articles/Edit/@Model.Id">
    <label>Titlu:</label><br />
    <input type="text" name="Title" value="@Model.Title" /><br /><br />

    <label>Conținut:</label><br />
    <textarea name="Content">@Model.Content</textarea><br /><br />

    <button type="submit">Salvează modificările</button>
</form>