@model IEnumerable<Laborator4.Models.Article>

<h1>Lista articole</h1>

<p><a href="/Articles/New">➕ Adaugă articol</a></p>

<table>
    <tr>
        <th>Titlu</th>
        <th>Data</th>
        <th>Acțiuni</th>
    </tr>

    @foreach (var a in Model)
    {
        <tr>
            <td>@a.Title</td>
            <td>@a.Date.ToShortDateString()</td>
            <td>
                <a href="/Articles/Show/@a.Id">👁️ Show</a> |
                <a href="/Articles/Edit/@a.Id">✏️ Edit</a> |
                <a href="/Articles/Delete/@a.Id">🗑️ Delete</a>
            </td>
        </tr>
    }
</table>