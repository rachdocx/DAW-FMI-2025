@model ExercitiuLaborator12.Models.Membership

@{
    ViewData["Title"] = "Ștergere abonament";
}

<h1>Ștergere abonament</h1>

<h3>Sunteți sigur că doriți să ștergeți acest abonament?</h3>

<div class="card" style="max-width: 400px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Titlu</dt>
            <dd class="col-sm-8">@Model.Titlu</dd>

            <dt class="col-sm-4">Valoare</dt>
            <dd class="col-sm-8">@Model.Valoare</dd>

            <dt class="col-sm-4">Data Emitere</dt>
            <dd class="col-sm-8">@Model.DataEmitere.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4">Sala de sport</dt>
            <dd class="col-sm-8">@Model.Gym?.Nume</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">sterge</button>
    <a asp-action="Index" class="btn btn-secondary">anuleaza</a>
</form>

